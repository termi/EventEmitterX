{
  "name": "@termi/eventemitterx",
  "version": "0.1.0",
  "description": "Another implementation of EventEmitter for Nodejs and browsers",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "index.ts",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "postinstall": "node _dev/postinstall/index.cjs",
    "test": "jest --config jest.config.js",
    "typecheck": "tsc -p tsconfig.library.json --noEmit",
    "build:cjs": "node _dev/build_library.cjs tsconfig.cjs.json",
    "build:esm": "node _dev/build_library.cjs tsconfig.esm.json",
    "build": "pnpm run build:cjs && pnpm run build:esm",
    "build:parallel": "node _dev/build_parallel.cjs",
    "typecheck:signals": "node _dev/check_signal_types.cjs",
    "typecheck:contracts": "node _dev/check_signal_types.cjs",
    "test:build": "node _dev/check_build_output.cjs",
    "verify": "node _dev/verify.cjs",
    "test:signals:gc": "node --expose-gc _dev/check_signal_lifecycle.cjs"
  },
  "dependencies": {
    "~": "link:./",
    "termi@ProgressControllerX": "link:./packages/ProgressControllerX",
    "termi@ServerTiming": "link:./packages/ServerTiming",
    "termi@abortable": "link:./packages/abortable",
    "termi@polyfills": "link:./packages/polyfills",
    "termi@runEnv": "link:./packages/runEnv",
    "termi@type_guards": "link:./packages/type_guards",
    "typescript": "latest"
  },
  "devDependencies": {
    "@jest/fake-timers": "27.5.1",
    "@jest/globals": "27.5.1",
    "@jest/reporters": "27.5.1",
    "@jest/types": "27.5.1",
    "@sinonjs/fake-timers": "9.1.0",
    "@types/jest": "27.4.1",
    "@types/node": "^25.3.2",
    "@types/sinonjs__fake-timers": "8.1.1",
    "jest": "27.5.1",
    "jest-cli": "27.5.1",
    "jsdom": "19.0.0",
    "ts-jest": "27.1.3",
    "ts-node": "10.5.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "*",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "*",
      "onFail": "error"
    }
  }
}
